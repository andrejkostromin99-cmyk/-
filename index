<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Анкета</title>
</head>
<body>

<h1>АНКЕТА</h1>

<table cellpadding="5">
<tr>
<td valign="top">
    <form id="form" onsubmit="showInfo(event)">
        <b>Ваше имя</b><br><br>
        <input type="text" id="name" size="30"><br><br>

        <b>Ваш пол</b><br><br>
        <input type="radio" name="gender" value="женский" checked> женский
        <input type="radio" name="gender" value="мужской"> мужской<br><br>

        <b>На каком курсе вы учитесь?</b><br><br>
        <select id="course">
            <option>первый</option>
            <option>второй</option>
            <option>третий</option>
            <option>четвёртый</option>
        </select><br><br>

        <b>Какие языки программирования вы знаете?</b><br><br>
        <input type="checkbox" class="lang" value="Паскаль"> Паскаль<br>
        <input type="checkbox" class="lang" value="C++"> C++<br>
        <input type="checkbox" class="lang" value="Ассемблер"> Ассемблер<br><br>

        <b>Напишите несколько слов о себе</b><br><br>
        <textarea id="about" rows="6" cols="45"></textarea><br><br>

        <input type="submit" value="Отправка данных">
        <input type="reset" value="Сброс" onclick="clearInfo()">
    </form>
</td>

<td valign="top" style="padding-left:60px">
    <h3>Ваша информация:</h3>
    <p><b>Имя:</b> <span id="out-name"></span></p>
    <p><b>Пол:</b> <span id="out-gender"></span></p>
    <p><b>Курс:</b> <span id="out-course"></span></p>
    <p><b>Языки:</b> <span id="out-lang"></span></p>
    <p><b>О себе:</b> <span id="out-about"></span></p>
</td>
</tr>
</table>

<script>
function showInfo(event) {
    event.preventDefault();

    let name = document.getElementById('name').value;
    document.getElementById('out-name').innerText = name || '...';

    let gender = document.querySelector('input[name="gender"]:checked').value;
    document.getElementById('out-gender').innerText = gender;

    let course = document.getElementById('course').value;
    document.getElementById('out-course').innerText = course;

    let langs = [];
    document.querySelectorAll('.lang:checked').forEach(function(cb) {
        langs.push(cb.value);
    });
    document.getElementById('out-lang').innerText = langs.length ? langs.join(', ') : '...';

    let about = document.getElementById('about').value;
    document.getElementById('out-about').innerText = about || '...';
}

function clearInfo() {
    document.getElementById('out-name').innerText = '...';
    document.getElementById('out-gender').innerText = '...';
    document.getElementById('out-course').innerText = '...';
    document.getElementById('out-lang').innerText = '...';
    document.getElementById('out-about').innerText = '...';
}
</script>

</body>
</html>
